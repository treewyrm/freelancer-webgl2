{
  "name": "@treewyrm/freelancer-webgl2",
  "version": "0.1.0",
  "description": "WebGL2 renderer faithfully reproducing Freelancer (Digital Anvil, 2003), built on @treewyrm/freelancer.",
  "keywords": [
    "freelancer",
    "digital anvil",
    "game",
    "webgl2",
    "renderer"
  ],
  "author": "Yuriy Alexeev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/treewyrm/freelancer-webgl2.git"
  },
  "homepage": "https://github.com/treewyrm/freelancer-webgl2#readme",
  "bugs": {
    "url": "https://github.com/treewyrm/freelancer-webgl2/issues"
  },
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#/*": "./dist/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.d.ts.map",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/!(*.gpu).test.ts\"",
    "test:gpu": "node --import tsx --test --test-concurrency=1 \"src/**/*.gpu.test.ts\"",
    "test:all": "npm test && npm run test:gpu",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "capture": "node --import tsx src/capture/report.ts",
    "reference": "node --import tsx src/reference/mount.ts",
    "bench": "node --import tsx src/reference/bench.ts",
    "view": "node --import tsx src/reference/view.ts",
    "prepublishOnly": "npm run typecheck && npm run test:all && npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@treewyrm/freelancer": "^2.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "tsdown": "^0.23.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
